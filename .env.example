# Copy these values into ParsPack PaaS Config/Secret.
# Never commit production UUIDs or the production path.

VLESS_USERS=ME=11111111-1111-1111-1111-111111111111,USER2=22222222-2222-2222-2222-222222222222
WS_PATH=/replace-with-a-long-random-path
MAX_SESSIONS=128
MAX_IPS_PER_USER=3
CONNECT_TIMEOUT_SECS=10
ALLOW_PRIVATE_TARGETS=false
TRUST_PROXY_HEADERS=true
